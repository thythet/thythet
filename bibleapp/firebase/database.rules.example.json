{
  "rules": {
    ".read": false,
    ".write": false,
    "bibleapp": {
      "profiles": {
        ".read": "(auth != null && auth.token.bibleappOwner === true || (auth != null && root.child('bibleapp').child('access').child(auth.uid).child('status').val() === 'active' && root.child('bibleapp').child('access').child(auth.uid).child('role').val() === 'admin'))",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (auth != null && auth.token.bibleappOwner === true || (auth != null && root.child('bibleapp').child('access').child(auth.uid).child('status').val() === 'active' && root.child('bibleapp').child('access').child(auth.uid).child('role').val() === 'admin')))",
          ".write": "auth != null && ((auth.uid === $uid && root.child('bibleapp').child('access').child(auth.uid).child('status').val() !== 'blocked') || (auth != null && auth.token.bibleappOwner === true || (auth != null && root.child('bibleapp').child('access').child(auth.uid).child('status').val() === 'active' && root.child('bibleapp').child('access').child(auth.uid).child('role').val() === 'admin')))",
          ".validate": "newData.hasChildren(['uid','displayName','email','photoURL','provider','createdAt','lastSeenAt']) && newData.child('uid').val() === $uid && (auth.uid !== $uid || newData.child('email').val() === auth.token.email)",
          "uid": {
            ".validate": "newData.isString() && newData.val() === $uid"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 254"
          },
          "photoURL": {
            ".validate": "newData.isString() && newData.val().length <= 2048"
          },
          "provider": {
            ".validate": "newData.val() === 'google.com'"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "lastSeenAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "access": {
        ".read": "(auth != null && auth.token.bibleappOwner === true || (auth != null && root.child('bibleapp').child('access').child(auth.uid).child('status').val() === 'active' && root.child('bibleapp').child('access').child(auth.uid).child('role').val() === 'admin'))",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (auth != null && auth.token.bibleappOwner === true || (auth != null && root.child('bibleapp').child('access').child(auth.uid).child('status').val() === 'active' && root.child('bibleapp').child('access').child(auth.uid).child('role').val() === 'admin')))",
          ".write": "auth != null && root.child('bibleapp').child('access').child($uid).child('role').val() !== 'owner' && ((auth != null && auth.token.bibleappOwner === true) || ((auth != null && root.child('bibleapp').child('access').child(auth.uid).child('status').val() === 'active' && root.child('bibleapp').child('access').child(auth.uid).child('role').val() === 'admin') && data.child('role').val() !== 'admin' && newData.child('role').val() !== 'admin'))",
          ".validate": "newData.hasChildren(['role','status','updatedAt']) && (newData.child('role').val() === 'user' || newData.child('role').val() === 'editor' || newData.child('role').val() === 'admin') && (newData.child('status').val() === 'pending' || newData.child('status').val() === 'active' || newData.child('status').val() === 'blocked')",
          "role": {
            ".validate": "newData.isString()"
          },
          "status": {
            ".validate": "newData.isString()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "study": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid && root.child('bibleapp').child('access').child(auth.uid).child('status').val() === 'active'",
          ".write": "auth != null && auth.uid === $uid && root.child('bibleapp').child('access').child(auth.uid).child('status').val() === 'active'",
          ".validate": "newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() > 0",
          "bookmarks": {
            "$key": {
              ".validate": "newData.hasChildren(['book','ch','n','text']) && newData.child('book').isString() && newData.child('ch').isNumber() && newData.child('n').isNumber() && newData.child('text').isString() && newData.child('text').val().length <= 10000",
              "$other": {
                ".validate": false
              }
            }
          },
          "highlights": {
            "$key": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            }
          },
          "notes": {
            "$key": {
              ".validate": "newData.isString() && newData.val().length <= 10000"
            }
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
