rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));}
  // This project uses Realtime Database rather than Firestore; cross-product role
  // checking is NOT available inside Storage Rules. Do not deploy this placeholder.
  // All photo access remains denied until a trusted backend sets custom claims.
  match /student-photos/{path=**} {allow read, write: if false;}
 }
}
