{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "accountRequests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid == $uid && !data.exists() && !root.child('users').child(auth.uid).exists() && newData.child('uid').val() == auth.uid && newData.child('email').val() == auth.token.email && newData.child('status').val() == 'pending'))",
        ".validate": "newData.hasChildren(['uid', 'email', 'status', 'requestedAt']) && newData.child('uid').isString() && newData.child('email').isString() && newData.child('name').isString() && newData.child('status').val() == 'pending' && newData.child('requestedAt').isNumber()",
        "uid": {
          ".validate": "newData.val() == $uid"
        },
        "email": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString()"
        },
        "provider": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "requestedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "churches": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$churchId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (root.child('users').child(auth.uid).child('churchId').val() == $churchId && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending'))",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "classes": {
      ".indexOn": [
        "churchId"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (query.orderByChild == 'churchId' && query.equalTo == root.child('users').child(auth.uid).child('churchId').val() && root.child('users').child(auth.uid).child('role').val() == 'pastor' || query.orderByChild == 'churchId' && query.equalTo == root.child('users').child(auth.uid).child('churchId').val() && root.child('users').child(auth.uid).child('role').val() == 'teacher')) && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending'",
      "$classId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (data.child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val() && (root.child('users').child(auth.uid).child('role').val() == 'pastor' || root.child('users').child(auth.uid).child('role').val() == 'teacher') && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending'))",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (root.child('users').child(auth.uid).child('role').val() == 'pastor' && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending' && (!data.exists() || data.child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val()) && (!newData.exists() || newData.child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val())) || (root.child('users').child(auth.uid).child('role').val() == 'teacher' && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending' && root.child('users').child(auth.uid).child('churchId').isString() && root.child('users').child(auth.uid).child('churchId').val() != '' && (( !data.exists() && newData.exists() && newData.child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val() && newData.child('createdByUid').val() == auth.uid ) || ( data.exists() && data.child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val() && data.child('createdByUid').val() == auth.uid && (!newData.exists() || ( newData.child('churchId').val() == data.child('churchId').val() && newData.child('createdByUid').val() == data.child('createdByUid').val() && newData.child('createdByEmail').val() == data.child('createdByEmail').val() && newData.child('createdAt').val() == data.child('createdAt').val() ))))))"
      }
    },
    "students": {
      ".indexOn": [
        "churchId"
      ],
      ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (query.orderByChild == 'churchId' && query.equalTo == root.child('users').child(auth.uid).child('churchId').val() && (root.child('users').child(auth.uid).child('role').val() == 'pastor' || root.child('users').child(auth.uid).child('role').val() == 'teacher') && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending'))",
      "$studentId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (data.child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val() && (root.child('users').child(auth.uid).child('role').val() == 'pastor' || root.child('users').child(auth.uid).child('role').val() == 'teacher') && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending'))",
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || ((root.child('users').child(auth.uid).child('role').val() == 'pastor' || root.child('users').child(auth.uid).child('role').val() == 'teacher') && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending' && (!data.exists() || data.child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val()) && (!newData.exists() || newData.child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val())))"
      }
    },
    "attendance": {
      "$date": {
        "$classId": {
          "$studentId": {
            ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || (root.child('students').child($studentId).child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val() && (root.child('users').child(auth.uid).child('role').val() == 'pastor' || root.child('users').child(auth.uid).child('role').val() == 'teacher') && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending'))",
            ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || ((root.child('users').child(auth.uid).child('role').val() == 'pastor' || root.child('users').child(auth.uid).child('role').val() == 'teacher') && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending' && root.child('students').child($studentId).child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val() && root.child('classes').child($classId).child('churchId').val() == root.child('users').child(auth.uid).child('churchId').val()))"
          }
        }
      }
    },
    "trash": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "activities": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$activityId": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!data.exists() && newData.exists() && newData.child('type').isString() && newData.child('path').isString() && newData.child('id').isString() && newData.child('label').isString() && newData.child('at').isNumber() && newData.child('role').val() == root.child('users').child(auth.uid).child('role').val() && (root.child('users').child(auth.uid).child('role').val() == 'pastor' || root.child('users').child(auth.uid).child('role').val() == 'teacher') && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('status').val() != 'pending'))"
      }
    },
    "cloudinaryAccounts": {
      "$ownerUid": {
        ".read": "auth != null && (auth.uid == $ownerUid && (root.child('admins').child(auth.uid).exists() || ((root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'pastor') && root.child('users').child(auth.uid).child('status').val() != 'pending' && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('active').val() != false)) || root.child('admins').child(auth.uid).exists())",
        "$storageId": {
          ".read": "auth != null && ((auth.uid == $ownerUid && (root.child('admins').child(auth.uid).exists() || ((root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'pastor') && root.child('users').child(auth.uid).child('status').val() != 'pending' && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('active').val() != false))) || root.child('admins').child(auth.uid).exists() || (root.child('cloudinaryShared').child(auth.uid).child($ownerUid).child($storageId).val() == true && (root.child('admins').child(auth.uid).exists() || ((root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'pastor') && root.child('users').child(auth.uid).child('status').val() != 'pending' && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('active').val() != false))))",
          ".write": "auth != null && auth.uid == $ownerUid && (root.child('admins').child(auth.uid).exists() || ((root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'pastor') && root.child('users').child(auth.uid).child('status').val() != 'pending' && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('active').val() != false))",
          ".validate": "newData.hasChildren(['label', 'cloudName', 'preset', 'folder', 'ack'])",
          "label": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
          },
          "cloudName": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{2,80}$/)"
          },
          "preset": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,100}$/)"
          },
          "folder": {
            ".validate": "newData.isString() && newData.val().length <= 180 && !newData.val().matches(/.*[<>]/)"
          },
          "ack": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "cloudinaryDefaults": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && (root.child('admins').child(auth.uid).exists() || ((root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'pastor') && root.child('users').child(auth.uid).child('status').val() != 'pending' && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('active').val() != false))",
        ".write": "auth != null && auth.uid == $uid && (root.child('admins').child(auth.uid).exists() || ((root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'pastor') && root.child('users').child(auth.uid).child('status').val() != 'pending' && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('active').val() != false))",
        ".validate": "newData.hasChildren(['key'])",
        "key": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 180"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "cloudinaryShared": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid && (root.child('admins').child(auth.uid).exists() || ((root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'pastor') && root.child('users').child(auth.uid).child('status').val() != 'pending' && root.child('users').child(auth.uid).child('status').val() != 'disabled' && root.child('users').child(auth.uid).child('active').val() != false))",
        "$ownerUid": {
          "$storageId": {
            ".validate": "newData.val() == true && root.child('admins').child($ownerUid).exists() && root.child('cloudinaryAccounts').child($ownerUid).child($storageId).exists() && root.child('users').child($uid).child('status').val() != 'disabled' && root.child('users').child($uid).child('status').val() != 'pending' && root.child('users').child($uid).child('active').val() != false"
          }
        }
      }
    }
  }
}
