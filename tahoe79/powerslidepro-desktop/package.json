{
  "name": "powerslidepro-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline PowerSlidePro editor using the Tahoe79 WebAssembly engine",
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "stage": "node scripts/stage.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check scripts/stage.cjs && node scripts/stage.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.thythet.powerslidepro",
    "productName": "PowerSlidePro",
    "asar": true,
    "directories": {"output": "dist"},
    "files": ["main.cjs", "preload.cjs", "payload/**/*", "package.json"],
    "win": {"target": "nsis"},
    "mac": {"target": "dmg", "category": "public.app-category.productivity", "identity": null},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "PowerSlidePro-${version}-${os}-${arch}.${ext}"
  }
}