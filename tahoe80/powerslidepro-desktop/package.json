{
  "name": "powerslidepro-desktop",
  "version": "0.1.16",
  "private": true,
  "description": "PowerSlidePro offline presentation software — Built and Prepared by Thet",
  "main": "main.cjs",
  "license": "UNLICENSED",
  "scripts": {
    "stage": "node scripts/stage.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check scripts/stage.cjs && node --check updater.cjs && node --check pc-fonts.cjs && node --check mac-fonts.cjs && node --check ui-font-prefs.cjs && node --check export-formats.cjs && node --check scripts/after-pack.cjs && node --test tests/export-formats.test.cjs tests/updater.test.cjs tests/pc-fonts.test.cjs tests/ui-font-prefs.test.cjs tests/ui-font-bridge.test.cjs tests/recent-files.test.cjs && python3 scripts/make_icons.py && python3 tests/document_icon_check.py && node scripts/stage.cjs && node --test tests/mac-fonts.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --x64 --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "35.7.5",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.thythet.powerslidepro",
    "productName": "PowerSlidePro",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updater.cjs",
      "pc-fonts.cjs",
      "mac-fonts.cjs",
      "ui-font-prefs.cjs",
      "export-formats.cjs",
      "payload/**/*",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "legalTrademarks": "PowerSlidePro — Thet",
      "fileAssociations": [
        {
          "ext": "deckcraft",
          "name": "PowerSlidePro Presentation",
          "description": "PowerSlidePro editable presentation",
          "icon": "deckcraft-orange-2026.ico"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns",
      "fileAssociations": [
        {
          "ext": "deckcraft",
          "name": "PowerSlidePro Presentation",
          "icon": "deckcraft.icns",
          "role": "Editor",
          "rank": "Owner"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": true,
      "include": "build/installer.nsh"
    },
    "artifactName": "PowerSlidePro-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "thythet",
        "repo": "thythet",
        "releaseType": "release"
      }
    ],
    "afterPack": "scripts/after-pack.cjs"
  },
  "author": "Thet",
  "dependencies": {
    "electron-updater": "6.6.2"
  }
}
